{
  "name": "@galacean/eslint-config",
  "version": "0.0.1",
  "description": "Shared ESLint configuration for Galacean TypeScript repositories",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./strict": "./src/strict.mjs",
    "./tests": "./src/tests.mjs",
    "./browser": "./src/browser.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@eslint/js": "^9.30.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-promise": "^7.3.0",
    "typescript-eslint": "^8.36.0"
  },
  "peerDependencies": {
    "eslint": ">=9.30.1",
    "typescript": ">=5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
