{
  "name": "monorepo-root",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Shared development tooling for Galacean repositories",
  "scripts": {
    "print-changelog": "print-changelog",
    "update-version": "update-version",
    "lint": "eslint .",
    "check:ts": "pnpm --filter \"./packages/**\" check:ts",
    "check": "pnpm check:ts && pnpm lint",
    "prepare": "husky",
    "publish": "pnpm -r publish --filter \"./packages/**\""
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@galacean/eslint-config": "workspace:*",
    "@galacean/release-tools": "workspace:*",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
