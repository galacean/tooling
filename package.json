{
  "name": "monorepo-root",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Shared development tooling for Galacean repositories",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "lint": "eslint .",
    "test": "pnpm --filter \"./packages/**\" test",
    "check:ts": "pnpm --filter \"./packages/**\" check:ts",
    "check": "pnpm check:ts && pnpm lint",
    "clean:nm": "pnpm -r exec rimraf node_modules && rimraf node_modules",
    "clean:dist": "pnpm -r --include-workspace-root exec rimraf dist",
    "clean:artifacts": "pnpm -r --include-workspace-root exec rimraf --glob \"src/**/*.js.map\"",
    "clean:declaration": "pnpm -r --include-workspace-root exec rimraf --glob \"*.tsbuildinfo\"",
    "clean:all": "pnpm clean:artifacts && pnpm clean:declaration && pnpm clean:dist && pnpm clean:nm",
    "print-changelog": "print-changelog",
    "update-version": "update-version",
    "preinstall": "only-allow pnpm",
    "prepare": "husky install",
    "publish": "pnpm -r publish --filter \"./packages/**\""
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "catalog:",
    "@galacean/eslint-config": "workspace:*",
    "@galacean/release-tools": "workspace:*",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.2",
    "rimraf": "^6.1.3",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
